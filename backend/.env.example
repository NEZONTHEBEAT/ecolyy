# =========================================================
# Ecolyy Backend Environment Variables
# =========================================================

APP_NAME=Ecolyy API
ENV=production
DEBUG=false
API_V1_PREFIX=/api/v1

# JWT
SECRET_KEY=replace-with-a-long-random-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# MongoDB
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/
MONGO_DB_NAME=ecolyy

# CORS
CORS_ORIGINS=https://your-frontend-domain.com

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Role emails
SUPER_ADMIN_EMAIL=
PARTNER_EMAILS=
INSTITUTE_EMAILS=

# Legacy/default passwords
# Leave empty unless required by legacy/demo functionality
DEFAULT_PARTNER_PASSWORD=
DEFAULT_INSTITUTE_PASSWORD=
DEFAULT_USER_PASSWORD=
DEFAULT_ADMIN_PASSWORD=

# Dashboard redirects
REDIRECT_ADMIN=/admin/dashboard.html
REDIRECT_PARTNER=/partner/dashboard.html
REDIRECT_INSTITUTE=/institution/dashboard.html
REDIRECT_USER=/user/dashboard.html

# OTP
OTP_EXPIRE_MINUTES=5

# SMTP
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@ecolyy.app
